@startuml casos_de_uso
!include estilo.iuml
title Diagrama de casos de uso — Subsistema de Gestión de Citas (Banco de la Nación)
left to right direction

actor "Cliente del banco" as Cliente
actor "Operador de ventanilla" as Operador
actor "Responsable de agencia" as Admin
actor "Pantalla de sala\nde espera" as Pantalla
actor "Sistema legado\n(Mainframe/AS400)" as Legado <<sistema>>

Admin -|> Operador

rectangle "Subsistema de citas (app web)" {
  package "Portal del cliente" {
    usecase "UC01 Identificarse con\ndocumento" as UC01
    usecase "UC02 Solicitar cita" as UC02
    usecase "UC03 Elegir canal\n(ventanilla / plataforma)" as UC03
    usecase "UC04 Elegir trámite y\nprioridad" as UC04
    usecase "UC05 Ver horarios\nsugeridos" as UC05
    usecase "UC06 Obtener ticket" as UC06
    usecase "UC07 Seguir turno en\ntiempo real" as UC07
    usecase "UC08 Cancelar cita" as UC08
    usecase "UC09 Unirse a\nvideollamada" as UC09
  }
  package "Panel interno" {
    usecase "UC10 Iniciar sesión\ninstitucional" as UC10
    usecase "UC11 Ver cola priorizada" as UC11
    usecase "UC12 Llamar siguiente\nturno" as UC12
    usecase "UC13 Consultar ficha\nde contexto" as UC13
    usecase "UC14 Finalizar atención" as UC14
    usecase "UC15 Ver indicadores\ndel día" as UC15
    usecase "UC16 Gestionar catálogo\n(trámites, horarios, ventanillas)" as UC16
    usecase "UC17 Exportar reporte\nde afluencia" as UC17
  }
  usecase "UC18 Mostrar turnos\nllamados" as UC18
  usecase "Validar documento" as UCV
}

Cliente --> UC01
Cliente --> UC02
Cliente --> UC07
Cliente --> UC08
Cliente --> UC09
UC02 ..> UC03 : <<include>>
UC02 ..> UC04 : <<include>>
UC02 ..> UC05 : <<include>>
UC02 ..> UC06 : <<include>>
UC01 ..> UCV : <<include>>
UCV --> Legado

Operador --> UC10
Operador --> UC11
Operador --> UC12
Operador --> UC13
Operador --> UC14
UC12 ..> UC13 : <<include>>
UC13 ..> UCV : <<include>>

Admin --> UC15
Admin --> UC16
Admin --> UC17

Pantalla --> UC18
@enduml
